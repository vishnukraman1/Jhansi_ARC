{
  "version": "1.0.0",
  "name": "Studio Architectural CAD Layer Profile",
  "description": "Standardized AIA CAD layer mapping and architectural design tokens for vector SVG conversion",
  "profiles": {
    "walls": {
      "className": "cad-wall",
      "patterns": ["*WALL*", "*A-WALL*", "*S-WALL*", "*STEM-WALL*", "*FOOTER*", "*FOOTPRINT*", "*CUT*"],
      "stroke": "#ffffff",
      "fill": "#181818",
      "strokeWidth": 1.3,
      "strokeLinejoin": "round",
      "strokeLinecap": "round"
    },
    "glazing": {
      "className": "cad-glaze",
      "patterns": ["*GLAZ*", "*WIND*", "*CURT*", "*GLASS*", "*A-GLAZ*", "*A- WINDOWS*"],
      "stroke": "#3b82f6",
      "fill": "none",
      "strokeWidth": 1.3,
      "strokeLinejoin": "round",
      "strokeLinecap": "round"
    },
    "doors": {
      "className": "cad-door",
      "patterns": ["*DOOR*", "*A-DOOR*", "*OPEN*", "*OPENING*", "*GARAGE-DOOR*", "*ENTR*"],
      "stroke": "#a3a3a3",
      "fill": "none",
      "strokeWidth": 0.85,
      "strokeLinejoin": "round",
      "strokeLinecap": "round"
    },
    "grid": {
      "className": "cad-grid",
      "patterns": ["*GRID*", "*S-GRID*", "*AXIS*", "*COL*", "*JOIST*", "*TRUSS*", "*BEAM*", "*HEADER*", "*SLAB*", "*OVERHANG*", "*OVERBUILD*"],
      "stroke": "#404040",
      "fill": "none",
      "strokeWidth": 0.4,
      "strokeDasharray": "4,4",
      "strokeLinecap": "butt"
    },
    "dimensions": {
      "className": "cad-dim",
      "patterns": ["*DIM*", "*A-DIM*", "*MEAS*"],
      "stroke": "#737373",
      "fill": "#737373",
      "strokeWidth": 0.45,
      "strokeLinecap": "round"
    },
    "annotations": {
      "className": "cad-anno",
      "patterns": ["*ANNO*", "*TEXT*", "*NOTE*", "*LABEL*", "*ROOM*", "*ANNTEXT*", "*B. NO.*"],
      "fill": "#a3a3a3",
      "stroke": "none",
      "fontFamily": "monospace",
      "fontSize": 9
    },
    "fixtures": {
      "className": "cad-floor",
      "patterns": ["*FLOR*", "*FURN*", "*FUNITURE*", "*EQUIP*", "*CASE*", "*PLUMB*", "*SAN*", "*FIXTURE*", "*LIGHT*", "*E .05*", "*ELE 0.1*", "*ELE 0.05*", "*A- ELE 4*", "*A-ELE 6*", "*ARCH-E_0.1*"],
      "stroke": "#525252",
      "fill": "none",
      "strokeWidth": 0.6,
      "strokeLinejoin": "round",
      "strokeLinecap": "round"
    },
    "default": {
      "className": "cad-default",
      "patterns": ["*"],
      "stroke": "#737373",
      "fill": "none",
      "strokeWidth": 0.55,
      "strokeLinejoin": "round",
      "strokeLinecap": "round"
    }
  }
}
